# --- Deepgram (required) -----------------------------------------------------
# An API key with Voice Agent access, from console.deepgram.com.
# It stays on the server: the browser talks to the local relay (relay.mjs).
DEEPGRAM_API_KEY=

# The model that does the thinking, and the voice. Defaults shown.
DEEPGRAM_THINK_PROVIDER=open_ai
DEEPGRAM_THINK_MODEL=gpt-5.5
DEEPGRAM_VOICE=aura-2-thalia-en

# --- One Connect (recommended) ------------------------------------------------
# Each visitor brings their own apps. Create the app in the One dashboard:
# Developers -> Connect -> New app, and register this exact redirect URI.
ONE_CLIENT_ID=
ONE_CLIENT_SECRET=
ONE_REDIRECT_URI=http://localhost:3030/api/one/callback
ONE_PERMISSION_SET=
# The app logos on the Connect button. Display only: any connected app works.
ONE_FEATURED_PLATFORMS=google-calendar,gmail,notion
# Optional: seal session cookies with this instead of the client secret, so the
# secret can be rotated without signing everyone out. Any long random string.
ONE_TOKEN_KEY=

# --- Or: your own One key -----------------------------------------------------
# Used only when the Connect values above are empty. The agent then uses the
# first connection of each platform in your own One account, with full access.
ONE_SECRET=
